          text: "      if (attempts > 200) break;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const sl = Math.floor(Math.random() * layers);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const sr = Math.floor(Math.random() * rows);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
