        lines {
          text: "export function generateRandomBoard("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  rows: number = 20,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  cols: number = 20,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  layers: number = 1,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  obstacleDensityPercent: number = 15,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  netCount: number = 3"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "): Board {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const obstacles: Coord[] = [];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const obstacleSet = new Set<string>();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const totalCells = rows * cols * layers;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const numObstacles = Math.floor((totalCells * obstacleDensityPercent) / 100);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  while (obstacles.length < numObstacles) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const l = Math.floor(Math.random() * layers);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const r = Math.floor(Math.random() * rows);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const c = Math.floor(Math.random() * cols);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const key = `${l},${r},${c}`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (!obstacleSet.has(key)) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      obstacleSet.add(key);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      obstacles.push({ layer: l, row: r, col: c });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
