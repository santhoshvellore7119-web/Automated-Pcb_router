1 = Bottom Layer (B.Cu)\n8:   netResults?: NetResult[];\n9:   activeStepVisited?: Set<string>;\n10:   activeStepCurrent?: Coord;\n11:   editorMode?: \'obstacle\' | \'erase\' | \'pin_source\' | \'pin_target\' | \'none\';\n12:   selectedNetId?: string;\n13:   onCellClick?: (coord: Coord) => void;\n14:   showHeatmap?: boolean;\n15:   cellPenalties?: Map<string, number>;\n16: }\n17: \n18: export const GridCanvas: React.FC<GridCanvasProps> = ({\n19:   board,\n20:   activeLayer,\n21:   netResults = [],\n22:   activeStepVisited,\n23:   activeStepCurrent,\n24:   editorMode = \'none\',\n25:   selectedNetId,\n26:   onCellClick,\n27:   showHeatmap = false,\n28:   cellPenalties,\n29: }) => {\n30:   const [hoveredCoord, setHoveredCoord] = useState<Coord | null>(null);\n31: \n32:   const { rows, cols, layers, obstacles, nets } = board;\n33: \n34:   // Build lookup maps for fast rendering\n35:   const obstacleMap = new Set(obstacles.map(coordKey));\n36: \n37:   // Source and Target pin maps: key -> Net\n38:   const sourcePins = new Map<string, Net>();\n39:   const targetPins = new Map<string, Net>();\n40:   nets.forEach((n) => {\n41:     sourcePins.set(coordKey(n.source), n);\n42:     targetPins.set(coordKey(n.target), n);\n43:   });\n44: \n45:   // Calculate cell sizes dynamically so grid fits responsively\n46:   const maxPixelWidth = 720;\n47:   const cellSize = Math.max(12, Math.min(36, Math.floor(maxPixelWidth / cols)));\n48: \n49:   // Collect trace segments and vias across all routed net results\n50:   const traceSegments: Array<{\n51:     x1: number;\n52:     y1: number;\n53:     x2: number;\n54:     y2: number;\n55:     layer: number;\n56:     color: string;\n57:     netName: string;\n58:   }> = [];\n59: \n60:   const vias: Array<{\n61:     row: number;\n62:     col: number;\n63:     color: string;\n64:     netName: string;\n65:   }> = [];\n66: \n67:   netResults.forEach((nr) => {\n68:     if (nr.status !== \'ROUTED\' || !nr.path || nr.path.length < 2) return;\n69: \n70:     for (let i = 1; i < nr.path.length; i++) {\n71:       const p1 = nr.path[i - 1];\n72:       const p2 = nr.path[i];\n73: \n74:       if (p1.layer !== p2.layer) {\n75:         // Via layer hop at p1 location\n76:         vias.push({\n77:           row: p1.row,\n78:           col: p1.col,\n79:           color: nr.color,\n80:           netName: nr.netName,\n81:         });\n82:       } else {\n83:         traceSegments.push({\n84:           x1: p1.col * cellSize + cellSize / 2,\n85:           y1: p1.row * cellSize + cellSize / 2,\n86:           x2: p2.col * cellSize + cellSize / 2,\n87:           y2: p2.row * cellSize + cellSize / 2,\n88:           layer: p1.layer,\n89:           color: nr.color,\n90:           netName: nr.netName,\n91:         });\n92:       }\n93:     }\n94:   });\n95: \n96:   // Render SVG Grid Cells\n97:   const gridRows = [];\n98:   for (let r = 0; r < rows; r++) {\n99:     for (let c = 0; c < cols; c++) {\n100:       const coord: Coord = { layer: activeLayer, row: r, col: c };\n101:       const key = coordKey(coord);\n102: \n103:       const isObstacle = obstacleMap.has(key);\n104:       const srcNet = sourcePins.get(key);\n105:       const tgtNet = targetPins.get(key);\n106: \n107:       const isVisited = activeStepVisited?.has(key);\n108:       const isCurrentHead =\n109:         activeStepCurrent?.layer === activeLayer &&\n110:         activeStepCurrent.row === r &&\n111:         activeStepCurrent.col === c;\n112: \n113:       const penalty = cellPenalties?.get(key) || 0;\n114: \n115:       // Color computation for cell background\n116:       let cellBg = \'fill-slate-900/90\';\n117:       if (isObstacle) {\n118:         cellBg = \'fill-slate-700/90 stroke-slate-600\';\n119:       } else if (showHeatmap && penalty > 0) {\n120:         // Heatmap color gradient based on penalty count\n121:         const heatRatio = Math.min(1, penalty / 20);\n122:         cellBg = heatRatio > 0.5 ? \'fill-rose-500/50\' : \'fill-amber-500/40\';\n123:       } e